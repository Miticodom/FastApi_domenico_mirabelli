{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "files.exclude": {
      "**/__pycache__": true
    },
    "workbench.colorCustomizations": {
      "activityBar.background": "#540754",
      "titleBar.activeBackground": "#760A76",
      "titleBar.activeForeground": "#FFF9FF",
      "titleBar.inactiveBackground": "#540754",
      "titleBar.inactiveForeground": "#FFF9FF",
      "statusBar.background": "#540754",
      "statusBar.foreground": "#FFF9FF",
      "statusBar.debuggingBackground": "#540754",
      "statusBar.debuggingForeground": "#FFF9FF",
      "statusBar.noFolderBackground": "#540754",
      "statusBar.noFolderForeground": "#FFF9FF"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Avvia server FastAPI",
        "type": "shell",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\avvia.ps1",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        },
        "runOptions": {
          "runOn": "folderOpen"
        }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "FastAPI (debug con F5)",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": ["main:app", "--reload"],
        "jinja": true,
        "console": "integratedTerminal"
      }
    ]
  }
}
